# ============================================================
# IACAS OTA — Configuration environnement
# Copier ce fichier en .env et renseigner les valeurs
# NE PAS committer le fichier .env
# ============================================================

# ------------------------------------------------------------
# Sécurité
# Générer avec : python -c "import secrets; print(secrets.token_hex(32))"
# ------------------------------------------------------------
SECRET_KEY=change-me-with-a-strong-random-key

# ------------------------------------------------------------
# Compte admin initial (créé automatiquement si users.json vide)
# Changer le mot de passe dès le premier démarrage
# ------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin_change_me

# ------------------------------------------------------------
# API Mistral AI
# ------------------------------------------------------------
MISTRAL_API_KEY=your-mistral-api-key-here

# ------------------------------------------------------------
# Répertoires de travail (utilisés côté serveur si pas d'agent local)
# ------------------------------------------------------------
ROOT_DIR=
ANNONCES_FILE_DIR=
ANNONCES_DIR_FILTER=
ANNONCES_DIR_STATE=
DIR_REA_FILE=
DIR_SOFT_SK_FILE=

# ------------------------------------------------------------
# Données (ne pas modifier sauf raison spécifique)
# ------------------------------------------------------------
AIXPLO_DIR=data/
AIXPLO_FILE=AixPlo.json

# ------------------------------------------------------------
# Agent local
# ------------------------------------------------------------
AGENT_PORT=5005
AGENT_TOKEN=change-me-same-as-secret-key
VPS_URL=https://votre-domaine.example.com

# ------------------------------------------------------------
# Environnement Flask
# development | production
# ------------------------------------------------------------
FLASK_ENV=development
